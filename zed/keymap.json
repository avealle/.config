// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    // I can't get negations of vim modes to work. Ideally this would be:
    // !(vim_mode == insert || vim_mode == visual)
    "context": "GitPanel || ProjectPanel || CollabPanel || OutlinePanel || ChatPanel || VimControl || EmptyPane || SharedScreen || MarkdownPreview || KeyContextView || DebugPanel",
    "bindings": {
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space o": "pane::RevealInProjectPanel"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "cmd-shift-t": "workspace::NewCenterTerminal",
      "space ?": ["task::Spawn", { "task_name": "Cursor" }],
      "space t f": ["task::Spawn", { "task_name": "RSpec: Run current file" }],
      "space t n": ["task::Spawn", { "task_name": "RSpec: Run nearest test" }],
      "space t b": [
        "task::Spawn",
        { "task_name": "Capybara: Run nearest test in browser" }
      ],
      "space p": "workspace::CopyRelativePath",
      "space p f": "workspace::CopyPath"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward"
    }
  },
  {
    "context": "Terminal || AgentPanel",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown"
    }
  }
]
